  {
    "id": "douleurs_abdominales_he",
    "title": "HUILES ESSENTIELLES ET DOULEURS ABDOMINALES",
    "category": "AROMATHERAPY",
    "author": {
      "name": "Priscillia Devaux",
      "role": "Naturopathe certifiée"
    },
    "summary": "Les huiles essentielles peuvent aider à apaiser les douleurs abdominales liées aux troubles digestifs.",
    "items": [
      {
        "name": "Menthe poivrée",
        "latin_name": "Mentha x piperita",
        "properties": ["Digestive"],
        "contraindications": [
          "Femmes enceintes ou allaitantes",
          "Enfants",
          "Personnes âgées",
          "Personnes cardiaques, épileptiques, asthmatiques",
          "Hypertension"
        ]
      },
      {
        "name": "Basilic exotique / tropical",
        "latin_name": "Ocimum basilicum ssp basilicum",
        "properties": ["Antispasmodique", "Tonique digestive", "Anti-inflammatoire"],
        "contraindications": [
          "Dermocaustique (à diluer)",
          "Cancer ou antécédent",
          "Maladie dégénérative",
          "3 premiers mois de grossesse",
          "Enfants de moins de 12 ans / moins de 40kg"
        ]
      }
    ],
    "protocols": [
      {
        "indication": "Douleurs digestives (crampes, spasmes)",
        "application_site": "Ventre / Côlon",
        "steps": [
          "Diluer 1 goutte d'huile essentielle dans un peu d'huile végétale.",
          "Masser une main dans le sens du transit sur la zone du côlon pendant 2 minutes."
        ]
      }
    ],
    "precautions": [
      "Usage externe uniquement.",
      "Réaliser un test de tolérance dans le creux du coude 24h avant.",
      "Ne jamais appliquer sur les muqueuses, yeux, nez, oreilles.",
      "Se laver les mains après utilisation."
    ]
  },
  {
    "id": "tempetes_emotionnelles_he",
    "title": "HUILES ESSENTIELLES POUR APAISER LES TEMPÊTES ÉMOTIONNELLES",
    "category": "AROMATHERAPY",
    "author": {
      "name": "Priscillia Devaux",
      "role": "Naturopathe certifiée"
    },
    "summary": "Les huiles essentielles peuvent contribuer à apaiser le système nerveux en cas de stress, d'irritabilité ou d'agitation mentale.",
    "items": [
      {
        "name": "Lavande vraie ou officinale",
        "latin_name": "Lavandula angustifolia ssp angustifolia",
        "properties": ["Apaisante", "Régulatrice du système nerveux"],
        "contraindications": ["3 premiers mois de grossesse", "Enfants de moins de 6 ans"]
      },
      {
        "name": "Orange douce",
        "latin_name": "Citrus sinensis",
        "properties": ["Calmante", "Sédative"],
        "contraindications": ["3 premiers mois de grossesse", "Enfants de moins de 6 ans", "Photosensibilisante"]
      },
      {
        "name": "Petit grain de bigarade",
        "latin_name": "Citrus aurantium ssp aurantium",
        "properties": ["Relaxante", "Sédative", "Régulatrice du système nerveux"],
        "contraindications": ["3 premiers mois de grossesse", "Enfants de moins de 6 ans"]
      }
    ],
    "protocols": [
      {
        "indication": "Inhalation sèche",
        "application_site": "Mouchoir",
        "steps": ["Verser 2 gouttes sur un mouchoir et respirer profondément quelques secondes."]
      },
      {
        "indication": "Diffusion atmosphérique",
        "application_site": "Air ambiant",
        "steps": ["Mélanger 3 à 5 gouttes pour 100ml d'eau.", "Diffuser 5 minutes par heure."]
      }
    ],
    "precautions": [
      "Ne pas diffuser en présence de personnes qui dorment, asthmatiques, épileptiques, enfants ou animaux.",
      "Ne jamais appliquer pure sur la peau."
    ]
  },
