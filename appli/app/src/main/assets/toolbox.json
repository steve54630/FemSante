        "contraindications": ["Grossesse", "Allaitement", "Diabète"]
      },
      {
        "name": "Tilleul",
        "latin_name": "Tilia vulgaris",
        "properties": ["Calmante", "Anti-insomnie", "Anti-irritabilité"],
        "contraindications": []
      },
      {
        "name": "Lavande vraie ou officinale",
        "latin_name": "Lavandula angustifolia",
        "properties": ["Calmante", "Facilite l'endormissement"],
        "contraindications": []
      }
    ],
    "protocols": [
      {
        "indication": "Préparation d'une infusion",
        "application_site": "Voie orale",
        "steps": [
          "Mettre 1 c.à.c (tasse) ou 1 c.à.s (bol) de plante.",
          "Verser l'eau frémissante à 95°C.",
          "Couvrir et laisser infuser 10 minutes.",
          "Filtrer et consommer."
        ]
      }
    ],
    "precautions": [
      "Privilégier les plantes en vrac et bio.",
      "Ne remplace pas un traitement médical ou une psychothérapie."
    ]
