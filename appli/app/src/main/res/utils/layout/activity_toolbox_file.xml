<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- En-tête coloré : catégorie + titre + auteur -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/orange_app"
            app:cardCornerRadius="18dp"
            app:cardElevation="3dp"
            app:contentPadding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textAllCaps="true"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:alpha="0.9"
                    tools:text="Phytothérapie" />

                <TextView
                    android:id="@+id/tvTitle"
                    style="@style/AppTextAppearance.HeadlineSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    tools:text="HUILES ESSENTIELLES ET DOULEURS ABDOMINALES" />

                <TextView
                    android:id="@+id/tvAuthor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="@color/white"
                    android:textSize="12sp"
                    android:alpha="0.85"
                    tools:text="Par Priscillia Devaux — Naturopathe certifiée" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Résumé / Introduction -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:contentPadding="16dp">

            <TextView
                android:id="@+id/tvSummary"
                style="@style/SummaryDetailStyle"
                android:textColor="@color/black"
                tools:text="Les huiles essentielles peuvent aider à apaiser les douleurs abdominales liées aux troubles digestifs." />
        </com.google.android.material.card.MaterialCardView>

        <!-- Liste des éléments (Plantes, Huiles, Matériel) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardItems"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:contentPadding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SummarySectionTitle"
                    android:text="Ingrédients / Éléments" />

                <View style="@style/SummaryDivider" />

                <LinearLayout
                    android:id="@+id/llItems"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Protocoles / Application -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardProtocols"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:contentPadding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SummarySectionTitle"
                    android:text="Mode d'application" />

                <View style="@style/SummaryDivider" />

                <LinearLayout
                    android:id="@+id/llProtocols"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Précautions & Sécurité (Fond neutre/soft - pas de rose) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPrecautions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/day_medium"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:contentPadding="16dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SummarySectionTitle"
                    android:text="Précautions et sécurité"
                    android:textColor="@color/black" />

                <View style="@style/SummaryDivider" />

                <LinearLayout
                    android:id="@+id/llPrecautions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>