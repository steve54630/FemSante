<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context="com.audreyRetournayDiet.femSante.features.ToolboxActivity">

    <TextView
        android:id="@+id/textTitle"
        style="@style/AppTextAppearance.TitleFancy.Hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/option_outils" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerToolbox"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_l"
        tools:listitem="@layout/item_toolbox_tool" />
</LinearLayout>
