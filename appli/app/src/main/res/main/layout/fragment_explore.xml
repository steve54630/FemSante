<?xml version="1.0" encoding="utf-8"?>
<!--
  Onglet "Découvrir" : la bibliothèque de contenus (nutrition, bien-être, boîte à outils).
  Séparé de "Pour toi" (le personnalisé) pour clarifier les deux espaces.
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fond_appli"
    android:fillViewport="true"
    tools:context=".features.main.ExploreFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingBottom="24dp">

        <TextView
            style="@style/AppTextAppearance.TitleFancy"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/nav_decouvrir"
            />

        <Button
            android:id="@+id/buttonAlim"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/option_alim" />

        <Button
            android:id="@+id/buttonTete"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/option_tete" />

        <Button
            android:id="@+id/buttonCorps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/option_corps" />

        <Button
            android:id="@+id/buttonOutils"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/option_outils" />

    </LinearLayout>
</ScrollView>
