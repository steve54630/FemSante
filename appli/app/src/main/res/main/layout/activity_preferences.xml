<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fond_appli"
    android:fillViewport="true"
    tools:context=".features.main.PreferencesActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="32dp">

        <TextView
            style="@style/AppTextAppearance.TitleFancy.Hero"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/preferences_title"
            />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/preferences_cycle_section"
            android:textColor="?attr/colorPrimary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/cycle_profile_message"
            android:textSize="13sp" />

        <RadioGroup
            android:id="@+id/radioGroupProfile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <RadioButton
                android:id="@+id/radioRegular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cycle_profile_regular" />

            <RadioButton
                android:id="@+id/radioIrregular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cycle_profile_irregular" />

            <RadioButton
                android:id="@+id/radioAbsent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/cycle_profile_absent" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/cycle_length_label"
            android:textStyle="bold" />

        <NumberPicker
            android:id="@+id/pickerCycleLength"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/period_length_label"
            android:textStyle="bold" />

        <NumberPicker
            android:id="@+id/pickerPeriodLength"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />

        <Button
            android:id="@+id/buttonSavePreferences"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="@string/preferences_save" />

    </LinearLayout>
</ScrollView>
