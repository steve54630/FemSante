<?xml version="1.0" encoding="utf-8"?>
<!--
  Onglet "Pour toi" (accueil par défaut) : espace personnalisé — geste du jour mis en
  avant (la reco la mieux notée) + le reste des recommandations. La bibliothèque de
  contenus vit dans l'onglet "Découvrir".
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fond_appli"
    android:fillViewport="true"
    tools:context=".features.main.PourToiFragment">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingBottom="24dp">

        <TextView
            style="@style/AppTextAppearance.TitleFancy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/nav_pour_toi"
            />

        <!-- Ta recette du jour : proposée selon la phase du cycle (indépendante du journal) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRecipeOfDay"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:visibility="gone"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:contentPadding="16dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recipe_of_day_label"
                    android:textColor="@color/orange_app"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textRecipeTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="Velouté d'épinards, amandes et noisettes" />

                <TextView
                    android:id="@+id/textRecipeMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:textSize="13sp"
                    tools:text="Entrée · 22 min" />

                <TextView
                    android:id="@+id/textRecipePhase"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/orange_app"
                    android:textSize="13sp"
                    android:visibility="gone"
                    tools:text="Adaptée à ta phase folliculaire"
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonRecipeAction"
                    style="@style/Widget.App.Button.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/recipe_of_day_action" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Micronutriments adaptés à ta phase : masqué si la phase est inconnue (pas de repli,
             contrairement à la recette du jour — cf. MicronutrientsForPhase) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPhaseMicronutrients"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:visibility="gone"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:contentPadding="16dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/textPhaseMicronutrientsLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="@color/orange_app"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:text="🌿 Pour ta phase folliculaire" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupPhaseMicronutrients"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Ton geste du jour : une seule action douce, la mieux notée -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardGesteDuJour"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:visibility="gone"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:contentPadding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/geste_du_jour_label"
                    android:textColor="@color/orange_app"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textGestePrefix"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/geste_du_jour_prefix"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/textGesteTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    tools:text="L'automassage du ventre" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/buttonGesteAction"
                    style="@style/Widget.App.Button.Action"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/geste_du_jour_action"
                    app:icon="@android:drawable/ic_media_play"
                    app:iconTint="@color/white" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Bandeau incitatif : affiché uniquement s'il n'y a pas de saisie du jour -->
        <LinearLayout
            android:id="@+id/layoutPourToiBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_banner_incitatif"
            android:orientation="vertical"
            android:padding="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/pour_toi_banner_incitatif"
                android:textSize="13sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFillJournal"
                style="@style/Widget.App.Button.Main"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="8dp"
                android:text="@string/pour_toi_banner_action" />
        </LinearLayout>

        <!-- Reste des recommandations -->
        <TextView
            android:id="@+id/textRecoMoreTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/pour_toi_more_title"
            android:textColor="?attr/colorPrimary"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <HorizontalScrollView
            android:id="@+id/scrollRecommendations"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/space_m"
            android:paddingVertical="@dimen/space_xs"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/containerRecommendations"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />

        </HorizontalScrollView>

        <!-- État vide chaleureux : rien à proposer aujourd'hui -->
        <LinearLayout
            android:id="@+id/layoutPourToiEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingVertical="40dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@null"
                android:src="@drawable/ic_tab_pour_toi"
                app:tint="@color/orange_app" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:text="@string/pour_toi_empty"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="15sp" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
