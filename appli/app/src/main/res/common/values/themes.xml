<resources>
    <style name="Theme.FemSante" parent="Theme.Material3.Light.NoActionBar">

        <!-- Rôles M3 mappés sur la charte (fini les défauts violet/teal du template). -->
        <item name="colorPrimary">@color/yellow_app</item>
        <item name="colorOnPrimary">@color/black</item>
        <item name="colorPrimaryContainer">@color/yellow_soft</item>
        <item name="colorOnPrimaryContainer">@color/black</item>

        <item name="colorSecondary">@color/blue_app</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="colorSecondaryContainer">@color/blue_soft</item>
        <item name="colorOnSecondaryContainer">@color/black</item>

        <item name="colorTertiary">@color/orange_app</item>
        <item name="colorOnTertiary">@color/black</item>

        <item name="android:statusBarColor">?attr/colorPrimary</item>
        <!-- Fond jaune clair : on force les icônes système en sombre (sinon blanches = illisibles). -->
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:fitsSystemWindows">true</item>

        <item name="android:fontFamily">@font/dinpro</item>
        <item name="fontFamily">@font/dinpro</item>
        <item name="android:textColorPrimary">?attr/colorOnSurface</item>

        <item name="materialButtonStyle">@style/Widget.App.Button.Main</item>
        <item name="bottomNavigationStyle">@style/Widget.App.BottomNavigationView</item>
        <item name="editTextStyle">@style/Widget.App.EditText</item>
        <item name="spinnerStyle">@style/Widget.App.Spinner</item>
        <item name="textInputStyle">@style/Widget.App.TextInputLayout</item>

        <item name="textAppearanceHeadline6">@style/AppTextAppearance.HeadlineSmall</item>
        <item name="textAppearanceSubtitle1">@style/AppTextAppearance.BodyLarge</item>
        <item name="textAppearanceSubtitle2">@style/AppTextAppearance.BodyMedium</item>
        <item name="textAppearanceBody1">@style/AppTextAppearance.BodyLarge</item>
        <item name="textAppearanceBody2">@style/AppTextAppearance.BodyMedium</item>
        <item name="textAppearanceCaption">@style/AppTextAppearance.LabelSmall</item>
        <item name="textAppearanceButton">@style/AppTextAppearance.LabelLarge</item>
    </style>

    <!--
      Titre d'écran. Échelle unifiée à 3 niveaux qui ne diffèrent QUE par la taille
      (police, couleur, centrage inchangés) : base 40sp, .Compact 32sp, .Hero 52sp.
      Les layouts ne surchargent plus `android:textSize` : ils choisissent le style.
    -->
    <style name="AppTextAppearance.TitleFancy" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:fontFamily">@font/lato_bold</item>
        <item name="fontFamily">@font/lato_bold</item>
        <item name="android:textSize">40sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textAlignment">center</item>
        <item name="android:minHeight">48dp</item>
    </style>

    <!-- Titre + contenu immédiat (grille/liste/chips). -->
    <style name="AppTextAppearance.TitleFancy.Compact">
        <item name="android:textSize">32sp</item>
    </style>

    <!-- Écrans accueil / formulaire, avec de l'espace. -->
    <style name="AppTextAppearance.TitleFancy.Hero">
        <item name="android:textSize">52sp</item>
    </style>

    <style name="AppTextAppearance.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/dinpro</item>
        <item name="fontFamily">@font/dinpro</item>
    </style>

    <style name="AppTextAppearance.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/dinpro</item>
        <item name="fontFamily">@font/dinpro</item>
    </style>

    <style name="AppTextAppearance.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/dinpro</item>
        <item name="fontFamily">@font/dinpro</item>
    </style>

    <style name="AppTextAppearance.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/dinpro</item>
        <item name="fontFamily">@font/dinpro</item>
    </style>

    <style name="AppTextAppearance.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/dinpro</item>
        <item name="fontFamily">@font/dinpro</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="Widget.App.Button.Main" parent="Widget.Material3.Button">
        <item name="android:fontFamily">@font/dinpro</item>
        <item name="fontFamily">@font/dinpro</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/black</item>
        <item name="backgroundTint">@color/yellow_app</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.App.Button.Action" parent="Widget.App.Button.Main">
        <item name="backgroundTint">@color/blue_app</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">12dp</item>
    </style>

    <style name="Widget.App.BottomNavigationView" parent="Widget.Material3.BottomNavigationView">
        <item name="backgroundTint">@color/blue_app</item>
        <item name="itemIconTint">@color/bottom_nav_item</item>
        <item name="itemTextColor">@color/bottom_nav_item</item>
        <item name="itemActiveIndicatorStyle">@style/App.Nav.Indicator</item>
        <item name="itemTextAppearanceActive">@style/AppTextAppearance.LabelSmall</item>
        <item name="itemTextAppearanceInactive">@style/AppTextAppearance.LabelSmall</item>
    </style>

    <!-- Pastille de l'onglet actif : blanc translucide (reste dans la palette). -->
    <style name="App.Nav.Indicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">#33FFFFFF</item>
    </style>

    <style name="Widget.App.EditText" parent="Widget.AppCompat.EditText">
        <item name="android:fontFamily">@font/dinpro</item>
        <item name="fontFamily">@font/dinpro</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textColorHint">#757575</item>
    </style>

    <style name="Widget.App.TextInputLayout" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/yellow_app</item>
        <item name="hintTextColor">@color/yellow_app</item>
        <item name="android:fontFamily">@font/dinpro</item>
        <item name="fontFamily">@font/dinpro</item>
    </style>

    <style name="Widget.App.Spinner" parent="Widget.AppCompat.Spinner">
        <item name="android:background">@color/orange_app</item>
        <item name="android:padding">8dp</item>
        <item name="android:textAlignment">center</item>
    </style>

</resources>