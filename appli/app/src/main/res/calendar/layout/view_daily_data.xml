<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/fond_appli">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- En-tête : titre + actions -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <TextView
                android:id="@+id/tvSummaryTitle"
                style="@style/AppTextAppearance.TitleFancy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/containerActions"
                android:text="@string/daily_resume"
                android:textSize="26sp" />

            <LinearLayout
                android:id="@+id/containerActions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnDelete"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/entry_remove"
                    app:icon="@drawable/ic_delete" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEdit"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:contentDescription="@string/entry_modify"
                    app:icon="@drawable/ic_edit" />
            </LinearLayout>
        </RelativeLayout>

        <!-- Carte : État général -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:contentPadding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SummarySectionTitle"
                    android:text="@string/general" />

                <View style="@style/SummaryDivider" />

                <TextView
                    android:id="@+id/tvIsTired"
                    style="@style/SummaryDetailStyle"
                    tools:text="Fatigue : En forme" />

                <TextView
                    android:id="@+id/tvPainLevel"
                    style="@style/SummaryDetailStyle"
                    tools:text="Douleur : 2/10" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Carte : État psychologique -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:contentPadding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SummarySectionTitle"
                    android:text="@string/psychological" />

                <View style="@style/SummaryDivider" />

                <TextView
                    android:id="@+id/tvDayQuality"
                    style="@style/SummaryDetailStyle"
                    tools:text="Qualité du jour : Bonne" />

                <TextView
                    android:id="@+id/tvDifficultyCauses"
                    style="@style/SummaryDetailStyle"
                    tools:text="Causes : Stress" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Carte : Symptômes -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:contentPadding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SummarySectionTitle"
                    android:text="@string/symptom" />

                <View style="@style/SummaryDivider" />

                <TextView
                    android:id="@+id/tvLocalizedPains"
                    style="@style/SummaryDetailStyle"
                    tools:text="Zones : Ventre, Tête" />

                <TextView
                    android:id="@+id/tvHasNausea"
                    style="@style/SummaryDetailStyle"
                    tools:text="Nausées : Non" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Carte : Contexte -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="4dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:contentPadding="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SummarySectionTitle"
                    android:text="@string/context" />

                <View style="@style/SummaryDivider" />

                <TextView
                    android:id="@+id/tvPhysicalActivity"
                    style="@style/SummaryDetailStyle"
                    tools:text="Activité : Repos" />

                <TextView
                    android:id="@+id/tvTookMedication"
                    style="@style/SummaryDetailStyle"
                    tools:text="Traitement : Oui (Paracétamol)" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
