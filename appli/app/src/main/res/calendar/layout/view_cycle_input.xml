<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cycleInputSection"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cycle_section_title"
        android:textColor="?attr/colorPrimary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/textCyclePhase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switchPeriod"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/cycle_period_today"
        android:textAppearance="@style/TextAppearance.Material3.TitleSmall" />

    <TextView
        android:id="@+id/textPeriodPrediction"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/cycle_period_predicted_hint"
        android:textColor="?attr/colorPrimary"
        android:textSize="12sp"
        android:textStyle="italic"
        android:visibility="gone" />

    <TextView
        android:id="@+id/labelFlow"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/cycle_flow_label"
        android:textSize="14sp"
        android:visibility="gone" />

    <com.google.android.material.chip.ChipGroup
        android:id="@+id/chipGroupFlow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:visibility="gone"
        app:singleSelection="true">

        <com.google.android.material.chip.Chip
            android:id="@+id/chipFlowLight"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cycle_flow_light" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipFlowMedium"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cycle_flow_medium" />

        <com.google.android.material.chip.Chip
            android:id="@+id/chipFlowHeavy"
            style="@style/Widget.Material3.Chip.Filter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cycle_flow_heavy" />

    </com.google.android.material.chip.ChipGroup>

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/switchSpotting"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/cycle_spotting"
        android:textAppearance="@style/TextAppearance.Material3.TitleSmall" />

</LinearLayout>
