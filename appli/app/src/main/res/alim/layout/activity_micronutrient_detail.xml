<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".features.alim.MicronutrientDetailActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- En-tête coloré : groupe + nom + autre nom -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/blue_app"
            app:cardCornerRadius="18dp"
            app:cardElevation="3dp"
            app:contentPadding="18dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvGroup"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.9"
                    android:textAllCaps="true"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    tools:text="Vitamines hydrosolubles" />

                <TextView
                    android:id="@+id/tvName"
                    style="@style/AppTextAppearance.HeadlineSmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    tools:text="Vitamine B9" />

                <TextView
                    android:id="@+id/tvOtherName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:alpha="0.9"
                    android:textColor="@color/white"
                    android:textSize="15sp"
                    tools:text="Folates" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Apports conseillés -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:contentPadding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SummarySectionTitle"
                    android:text="@string/micronutrient_intake_title" />

                <View style="@style/SummaryDivider" />

                <LinearLayout
                    android:id="@+id/llIntake"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Sources alimentaires -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:contentPadding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SummarySectionTitle"
                    android:text="@string/micronutrient_sources_title" />

                <View style="@style/SummaryDivider" />

                <LinearLayout
                    android:id="@+id/llSources"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Cofacteurs d'assimilation (affiché seulement si présent) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardCofactors"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:visibility="gone"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:contentPadding="16dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SummarySectionTitle"
                    android:text="@string/micronutrient_cofactors_title" />

                <View style="@style/SummaryDivider" />

                <TextView
                    android:id="@+id/tvCofactors"
                    style="@style/SummaryDetailStyle"
                    android:textColor="@color/black"
                    tools:text="vitamine B12 et zinc" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Notes / précautions (affiché seulement si présent) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:layout_marginBottom="8dp"
            android:visibility="gone"
            app:cardBackgroundColor="@color/day_medium"
            app:cardCornerRadius="14dp"
            app:cardElevation="2dp"
            app:contentPadding="16dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    style="@style/SummarySectionTitle"
                    android:text="@string/micronutrient_notes_title" />

                <View style="@style/SummaryDivider" />

                <TextView
                    android:id="@+id/tvNotes"
                    style="@style/SummaryDetailStyle"
                    android:textColor="@color/black"
                    tools:text="Très sensible à la cuisson prolongée…" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
