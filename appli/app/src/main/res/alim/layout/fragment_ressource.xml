<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/fond_appli"
    android:orientation="vertical"
    tools:context=".features.alim.RessourceFragment">

    <TextView
        android:id="@+id/textView3"
        style="@style/AppTextAppearance.TitleFancy.Hero"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="20dp"
        android:text="@string/ressources" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerRessources"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/space_l"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_l"
        tools:listitem="@layout/item_resource_card" />
</LinearLayout>
